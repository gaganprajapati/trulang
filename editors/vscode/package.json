{
  "name": "trulang",
  "displayName": "TruLang",
  "description": "Rich Language Support, Syntax Highlighting, and Language Server Protocol for TruLang (.tr)",
  "version": "1.0.0",
  "publisher": "gaganprajapati",
  "author": {
    "name": "Gagan Prajapati",
    "url": "https://gagn.dev"
  },
  "license": "MIT",
  "homepage": "https://gagn.dev/trulang/",
  "repository": {
    "type": "git",
    "url": "https://github.com/gaganprajapati/trulang.git"
  },
  "bugs": {
    "url": "https://github.com/gaganprajapati/trulang/issues"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "trulang",
    "backend",
    "memory arenas",
    "actors",
    "lsp"
  ],
  "activationEvents": [
    "onLanguage:trulang"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "trulang",
        "aliases": ["TruLang", "trulang", "tr"],
        "extensions": [".tr"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "trulang",
        "scopeName": "source.trulang",
        "path": "./syntaxes/trulang.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "trulang.restartServer",
        "title": "TruLang: Restart Language Server",
        "category": "TruLang"
      },
      {
        "command": "trulang.runFile",
        "title": "TruLang: Run Current File",
        "category": "TruLang"
      },
      {
        "command": "trulang.checkFile",
        "title": "TruLang: Type Check Current File",
        "category": "TruLang"
      },
      {
        "command": "trulang.openDocs",
        "title": "TruLang: Open Documentation",
        "category": "TruLang"
      },
      {
        "command": "trulang.debugFile",
        "title": "TruLang: Debug Current File",
        "category": "TruLang"
      },
      {
        "command": "trulang.profileFile",
        "title": "TruLang: Profile Memory & Generate Flamegraph",
        "category": "TruLang"
      }
    ],
    "debuggers": [
      {
        "type": "trulang",
        "label": "TruLang Debugger",
        "languages": ["trulang"],
        "configurationSnippets": [
          {
            "label": "TruLang: Debug Current File",
            "description": "Initialize interactive debug session with TruLang DAP",
            "body": {
              "type": "trulang",
              "request": "launch",
              "name": "Debug TruLang File",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          }
        ],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .tr file to execute and debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop after launching the program.",
                "default": false
              },
              "requestBudget": {
                "type": "number",
                "description": "Region A transient request memory budget in bytes.",
                "default": 16777216
              },
              "persistentBudget": {
                "type": "number",
                "description": "Region B persistent DAG memory budget in bytes.",
                "default": 536870912
              }
            }
          }
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "TruLang",
      "properties": {
        "trulang.lsp.path": {
          "type": "string",
          "default": "trulang",
          "description": "Path to the trulang executable (defaults to 'trulang' in PATH)."
        },
        "trulang.lsp.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces the communication between VS Code and the TruLang language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.1",
    "typescript": "^5.3.3"
  }
}
